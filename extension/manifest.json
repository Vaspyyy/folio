{
  "manifest_version": 3,
  "name": "Folio — Personal Comic Library",
  "version": "0.6.0",
  "description": "A local-first comic library with autonomous discovery and a native reader.",
  "action": {
    "default_title": "Open Folio library"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "alarms",
    "offscreen",
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://multporn.net/*"
      ],
      "js": [
        "juicebox-bridge.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://multporn.net/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "host_permissions": [
    "https://multporn.net/*"
  ]
}
